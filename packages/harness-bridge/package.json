{
  "name": "@deepseek-bot/harness-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Cordis bridge plugin mounted inside the DeepSeek Harness profile: answers upstream approval/request waterfalls through the app's D08 permission gate over loopback HTTP (D12)",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/**",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
