{
  "scenario": "workflow-cycle",
  "covers": "CONTRACTS §2 Workflow 图无环；§3 workflow.validate；§6 WORKFLOW_CYCLE；§7 循环图",
  "notes": "n1 → n2 → n1 的循环图在保存/导入前被 workflow.validate 拒绝。错误可定位：code=WORKFLOW_CYCLE，nodeId 指向环上的节点，field 指向 edges。错误必须可执行（本夹具同时驱动图校验器实现）。",
  "interactions": [
    {
      "method": "workflow.validate",
      "envelope": {
        "protocolVersion": "0.1",
        "requestId": "10000000-0000-4000-8000-00000000000c",
        "method": "workflow.validate",
        "payload": {
          "workflow": {
            "name": "cyclic-demo",
            "schemaVersion": "0.1",
            "nodes": [
              {
                "id": "n1",
                "type": "bot",
                "botId": "11111111-1111-4111-8111-111111111111",
                "instructionTemplate": "Step one.",
                "inputBindings": [],
                "retryPolicy": { "maxRetries": 0 }
              },
              {
                "id": "n2",
                "type": "bot",
                "botId": "12121212-1212-4121-8121-121212121212",
                "instructionTemplate": "Step two.",
                "inputBindings": [],
                "retryPolicy": { "maxRetries": 0 }
              }
            ],
            "edges": [
              {
                "fromNodeId": "n1",
                "outputKey": "out",
                "toNodeId": "n2",
                "inputKey": "in"
              },
              {
                "fromNodeId": "n2",
                "outputKey": "out",
                "toNodeId": "n1",
                "inputKey": "in"
              }
            ],
            "limits": { "maxConcurrentNodes": 2 }
          }
        }
      },
      "expectedResponse": {
        "valid": false,
        "errors": [
          {
            "code": "WORKFLOW_CYCLE",
            "message": "workflow graph contains a cycle",
            "nodeId": "n2",
            "field": "edges"
          }
        ]
      }
    }
  ]
}
