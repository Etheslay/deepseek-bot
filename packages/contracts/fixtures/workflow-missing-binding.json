{
  "scenario": "workflow-missing-binding",
  "covers": "CONTRACTS §2 Edge 依赖与字段映射明确；§6 MISSING_BINDING",
  "notes": "n2 声明了 required 的输入 topic，但没有任何边向它供值，校验返回 MISSING_BINDING 并定位到节点与字段（inputBindings.topic）。独立分支不受影响——n1 自身合法，不产生错误。",
  "interactions": [
    {
      "method": "workflow.validate",
      "envelope": {
        "protocolVersion": "0.1",
        "requestId": "10000000-0000-4000-8000-00000000000d",
        "method": "workflow.validate",
        "payload": {
          "workflow": {
            "name": "missing-binding-demo",
            "schemaVersion": "0.1",
            "nodes": [
              {
                "id": "n1",
                "type": "bot",
                "botId": "11111111-1111-4111-8111-111111111111",
                "instructionTemplate": "Produce a topic.",
                "inputBindings": [],
                "retryPolicy": { "maxRetries": 0 }
              },
              {
                "id": "n2",
                "type": "bot",
                "botId": "12121212-1212-4121-8121-121212121212",
                "instructionTemplate": "Write about {{topic}}.",
                "inputBindings": [{ "inputKey": "topic", "required": true }],
                "retryPolicy": { "maxRetries": 0 }
              }
            ],
            "edges": [
              {
                "fromNodeId": "n1",
                "outputKey": "out",
                "toNodeId": "n2",
                "inputKey": "background"
              }
            ],
            "limits": { "maxConcurrentNodes": 2 }
          }
        }
      },
      "expectedResponse": {
        "valid": false,
        "errors": [
          {
            "code": "MISSING_BINDING",
            "message": "required input 'topic' of node 'n2' has no incoming edge",
            "nodeId": "n2",
            "field": "inputBindings.topic"
          }
        ]
      }
    }
  ]
}
