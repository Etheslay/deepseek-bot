{
  "scenario": "rate-limited",
  "covers": "CONTRACTS §6 RATE_LIMITED；§5 有限重试与 Retry-After",
  "notes": "模型供应商返回 429。重试请求再次被限流时返回错误对象：retryable=true、details 携带 Retry-After 秒数。重试有界（默认最多 2 次）且不承诺无额外费用；自动重试只用于确认无副作用的临时错误。",
  "interactions": [
    {
      "method": "run.retryNode",
      "envelope": {
        "protocolVersion": "0.1",
        "requestId": "10000000-0000-4000-8000-000000000003",
        "method": "run.retryNode",
        "payload": {
          "nodeRunId": "eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee"
        }
      },
      "expectedError": {
        "code": "RATE_LIMITED",
        "message": "model provider rate limited the request; retry after the indicated delay",
        "retryable": true,
        "requestId": "10000000-0000-4000-8000-000000000003",
        "details": { "retryAfterSeconds": 20, "attempt": 1, "maxRetries": 2 }
      }
    }
  ],
  "events": [
    {
      "eventId": "20000000-0000-4000-8000-000000000007",
      "runId": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
      "sequence": 6,
      "timestamp": "2026-10-24T10:01:00Z",
      "type": "node.statusChanged",
      "payload": {
        "nodeRunId": "eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee",
        "nodeId": "n1",
        "attempt": 1,
        "from": "running",
        "to": "failed",
        "reason": "HTTP 429 from model provider; retries exhausted"
      }
    },
    {
      "eventId": "20000000-0000-4000-8000-000000000008",
      "runId": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
      "sequence": 7,
      "timestamp": "2026-10-24T10:01:00Z",
      "type": "run.statusChanged",
      "payload": {
        "from": "running",
        "to": "failed",
        "reason": "node n1 failed: rate limited after bounded retries"
      }
    },
    {
      "eventId": "20000000-0000-4000-8000-000000000009",
      "runId": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
      "sequence": 8,
      "timestamp": "2026-10-24T10:01:00Z",
      "type": "run.failed",
      "payload": {
        "reason": "node n1 failed: rate limited after bounded retries",
        "errorCode": "RATE_LIMITED"
      }
    }
  ]
