{
  "scenario": "concurrent-edit",
  "covers": "CONTRACTS §1 expectedRevision；§3 bot.update；§6 REVISION_CONFLICT；§7 并发编辑",
  "notes": "两个界面同时基于同一 revision 编辑。第一个 update 携带的 expectedRevision 命中当前 revision，成功并产生新 revision；第二个 update 仍携带旧 revision，返回 REVISION_CONFLICT（retryable=false），details 带当前 revision，禁止静默覆盖。",
  "interactions": [
    {
      "method": "bot.update",
      "envelope": {
        "protocolVersion": "0.1",
        "requestId": "10000000-0000-4000-8000-000000000008",
        "method": "bot.update",
        "payload": {
          "id": "11111111-1111-4111-8111-111111111111",
          "expectedRevision": "22222222-2222-4222-8222-222222222222",
          "patch": { "name": "renamed-summarizer" }
        }
      },
      "expectedResponse": {
        "id": "11111111-1111-4111-8111-111111111111",
        "revision": "33333333-3333-4333-8333-333333333333",
        "name": "renamed-summarizer",
        "instructions": "You summarize notes.",
        "modelProfileId": "44444444-4444-4444-8444-444444444444",
        "workspaceId": "55555555-5555-4555-8555-555555555555",
        "toolPolicyId": "66666666-6666-4666-8666-666666666666",
        "archivedAt": null
      }
    },
    {
      "method": "bot.update",
      "envelope": {
        "protocolVersion": "0.1",
        "requestId": "10000000-0000-4000-8000-000000000009",
        "method": "bot.update",
        "payload": {
          "id": "11111111-1111-4111-8111-111111111111",
          "expectedRevision": "22222222-2222-4222-8222-222222222222",
          "patch": { "name": "concurrent-rename" }
        }
      },
      "expectedError": {
        "code": "REVISION_CONFLICT",
        "message": "bot was modified concurrently; reload and reapply the change",
        "retryable": false,
        "requestId": "10000000-0000-4000-8000-000000000009",
        "details": { "currentRevision": "33333333-3333-4333-8333-333333333333" }
      }
    }
  ]
}
