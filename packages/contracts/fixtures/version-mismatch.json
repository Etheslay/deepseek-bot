{
  "scenario": "version-mismatch",
  "covers": "CONTRACTS §1 protocolVersion；§3 workflow.import 先校验 schemaVersion；§7 拒绝未知更高版本，不能默默丢字段",
  "notes": "两条版本拒绝路径：(1) envelope 携带未知更高 protocolVersion 时整体拒绝，不解析 payload、不默默丢字段；(2) workflow.import 携带未知更高 schemaVersion 的模板时，返回 accepted=false 且 errorCode=DATA_VERSION_UNSUPPORTED。二者都要求显式升级，不做静默兼容。",
  "interactions": [
    {
      "method": "bot.list",
      "expectEnvelopeRejected": true,
      "envelope": {
        "protocolVersion": "9.9",
        "requestId": "10000000-0000-4000-8000-000000000011",
        "method": "bot.list",
        "payload": {}
      }
    },
    {
      "method": "workflow.import",
      "envelope": {
        "protocolVersion": "0.1",
        "requestId": "10000000-0000-4000-8000-000000000012",
        "method": "workflow.import",
        "payload": {
          "template": {
            "schemaVersion": "9.9",
            "workflow": {
              "name": "from-the-future",
              "schemaVersion": "9.9",
              "nodes": [
                {
                  "id": "n1",
                  "type": "bot",
                  "botId": "11111111-1111-4111-8111-111111111111",
                  "instructionTemplate": "Anything.",
                  "inputBindings": [],
                  "retryPolicy": { "maxRetries": 0 }
                }
              ],
              "edges": [],
              "limits": { "maxConcurrentNodes": 2 },
              "futureField": { "note": "unknown fields from newer templates stay data and never become executable" }
            }
          }
        }
      },
      "expectedResponse": {
        "accepted": false,
        "errors": [],
        "errorCode": "DATA_VERSION_UNSUPPORTED"
      }
    }
  ]
}
